# Set APP_MODE=persistent to disable the local fictional-data demo.
APP_MODE=demo

# Use the pooled Neon connection string (hostname includes "-pooler").
DATABASE_URL=

# Generate with: npx auth secret
BETTER_AUTH_SECRET=

# Use http://localhost:3000 locally and the app's HTTPS URL in Vercel.
BETTER_AUTH_URL=http://localhost:3000

# Keep this stable across deployments. Generate a 32-byte base64 key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Required in persistent mode for private prescription image storage.
BLOB_READ_WRITE_TOKEN=
