# Set APP_MODE=persistent to disable the local fictional-data demo.
APP_MODE=demo

# Copy the Neon PostgreSQL connection string from the Vercel integration.
DATABASE_URL=

# Generate with: npx auth secret
BETTER_AUTH_SECRET=

# Use http://localhost:3000 locally and the app's HTTPS URL in Vercel.
BETTER_AUTH_URL=http://localhost:3000
